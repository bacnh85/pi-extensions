{
  "name": "@bacnh85/pi-kicad",
  "version": "0.1.1",
  "description": "KiCad CAD-design extension for Pi — drive schematic capture and PCB layout via the Konnect binary over a local HTTP daemon (no MCP SDK).",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "homepage": "https://github.com/bacnh85/pi-extensions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bacnh85/pi-extensions.git",
    "directory": "pi-kicad"
  },
  "bugs": { "url": "https://github.com/bacnh85/pi-extensions/issues" },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "kicad",
    "eda",
    "pcb",
    "schematic",
    "cad",
    "konnect"
  ],
  "scripts": {
    "test": "cd extensions && npx mocha",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "README.md",
    "extensions/index.ts",
    "extensions/lib/",
    "extensions/package.json",
    "skills/"
  ],
  "pi": { "extensions": ["./extensions/index.ts"], "skills": ["./skills"] },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.41",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0"
  }
}
