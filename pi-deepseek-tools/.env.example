# pi-deepseek-tools — Quick-start config
#
# Copy this to .env (or merge into your Pi global .env) and uncomment as needed.
# All vars are optional — defaults work for most users.
#
# ── Tool behavior ──────────────────────────────────────

# Block Serena/dedicated-tool misses instead of reminding
# PI_DEEPSEEK_TOOLS_STRICT_SERENA=1

# Disable tool-selection guidance injection
# PI_DEEPSEEK_TOOLS_SELECTION_GUIDANCE=0

# Disable tool-input argument repair
# PI_DEEPSEEK_TOOLS_REPAIR_ENABLED=0

# Also apply to direct deepseek provider (not just OpenCode Go)
# PI_DEEPSEEK_TOOLS_DIRECT_DEEPSEEK=1

# ── Reasoning handling ─────────────────────────────────

# Strip reasoning_content / thinking_content from prior turns
# PI_DEEPSEEK_TOOLS_STRIP_REASONING=1

# Truncate long prior reasoning values (chars, not tokens)
# PI_DEEPSEEK_TOOLS_REASONING_MAX_TOKENS=1024

# ── Thinking budget ────────────────────────────────────

# Flat thinking-budget cap for all turns (helps avoid 400s on tool-heavy turns)
# PI_DEEPSEEK_TOOLS_THINKING_BUDGET=1024

# ── Safety & escalation ────────────────────────────────

# Block rm -rf / and dd to block device
# PI_DEEPSEEK_TOOLS_BLOCK_DANGEROUS_COMMANDS=1

# Auto-block tool misses after N reminders on same pattern
# PI_DEEPSEEK_TOOLS_AUTO_BLOCK_AFTER_REMINDERS=5

# ── Diagnostics ────────────────────────────────────────

# Enable stderr debug logging
# PI_DEEPSEEK_TOOLS_DEBUG=1

# Structured JSON log lines instead of plain text
# PI_DEEPSEEK_TOOLS_LOG_FORMAT=json

# Max tracked tool errors in history (LRU eviction)
# PI_DEEPSEEK_TOOLS_MAX_ERROR_HISTORY=100
