{
  "name": "@bacnh85/pi-review",
  "version": "0.2.2",
  "description": "Pi extension for isolated or local read-only code review.",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "homepage": "https://github.com/bacnh85/pi-extensions#readme",
