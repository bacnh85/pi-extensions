    "@yuuang/ffi-rs-linux-x64-gnu": "1.3.2"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.41",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
