{
  "name": "@bacnh85/pi-fff",
  "version": "0.7.8",
  "description": "Pi extension: FFF-powered fuzzy file and content search.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/bacnh85/pi-extensions#readme",
