{
  "name": "@bacnh85/pi-munin",
  "version": "0.5.1",
  "description": "Pi extension that provides native Munin long-term memory tools through direct SDK integration.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/bacnh85/pi-extensions/tree/main/pi-munin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bacnh85/pi-extensions.git",
    "directory": "pi-munin"
  },
  "bugs": {
    "url": "https://github.com/bacnh85/pi-extensions/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "munin",
    "memory",
    "long-term-memory"
  ],
  "scripts": {
    "test": "cd extensions && npx mocha",
    "test:unit": "cd extensions && npx mocha --spec 'test/unit/**/*.test.ts'"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "extensions/package.json",
    "extensions/index.ts",
    "extensions/lib/",
    "skills/"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@kalera/munin-sdk": "^1.5.0",
    "dotenv": "^16.4.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "chai": "^4.3.0",
    "mocha": "^10.8.2",
    "tsx": "^4.0.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.7"
  }
}
