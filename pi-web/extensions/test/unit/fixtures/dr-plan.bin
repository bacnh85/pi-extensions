[["wrb.fr",null,"[null,[\"c_10950ff6b1b0ebc1\",\"r_b1a8e63da21ae244\"],null,null,[[\"rc_a9a08f9572db6424\",[\"Here's the plan I've put together. Let me know if you need any changes before I start researching.\\nhttp://googleusercontent.com/deep_research_confirmation_content/0\\n\"],null,null,null,null,null,null,[1],\"en\",null,null,[{\"8\":[],\"56\":[\"History of JPEG Compression\",[[1,\"Research Websites\",\"(1) Investigate the pre-JPEG origins of image compression, focusing on the invention of the Discrete Cosine Transform (DCT) in 1974 and early compression research.\\n(2) Research the formation of the Joint Photographic Experts Group committee in 1986 by ISO, IEC, and ITU-T, identifying key contributors and initial goals.\\n(3) Trace the development process and formal standardization of JPEG leading to the publication of ISO/IEC 10918-1 (ITU-T T.81) in 1992.\\n(4) Analyze the core technical components defined in the original JPEG standard:\\n   (a) Color space conversion (RGB to YCbCr) and chrominance subsampling\\n   (b) 8x8 block-based Discrete Cosine Transform (DCT)\\n   (c) Quantization matrix selection and lossy compression trade-offs\\n   (d) Entropy encoding techniques including Huffman coding and arithmetic coding\\n(5) Investigate major patent controversies and licensing challenges, such as the Forgent Networks patent enforcement attempt in the early 2000s.\\n(6) Evaluate the historical impact of JPEG on the growth of the World Wide Web, digital photography, and personal computing.\\n(7) Examine the development of successor image standards (JPEG 2000, JPEG XR, JPEG XL, WebP, AVIF) and analyze why the original JPEG format maintains broad dominance.\"],[2,\"Analyze Results\"],[3,\"Create Report\"]],\"Ready in a few mins\",[\"Start research\"],[\"http://googleusercontent.com/deep_research_confirmation_content/0\",0],[\"Edit plan\",[null,null,null,\"Edit the research plan\"]]],\"70\":2}],null,null,null,null,null,null,null,null,null,null,null,null,null,null,